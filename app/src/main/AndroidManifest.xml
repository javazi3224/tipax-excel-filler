<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- تایپ صوتی از طریق میکروفون خودِ کیبورد گوشی (مثلاً Gboard) کار می‌کنه
         و نیازی به مجوز میکروفون جداگانه تو این اپ نداره. فایل اکسل هم فقط
         تو فضای داخلی خود اپ ساخته می‌شه و فقط برای اشتراک‌گذاری استفاده
         می‌شه، پس نیازی به مجوز ذخیره‌سازی هم نیست. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ExcelFiller"
        android:supportsRtl="true">

        <activity
            android:name=".LockActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="ir.tipaxrezashahr.excelfiller.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
